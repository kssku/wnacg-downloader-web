# ════════════════════════════════════════════════════════════════════
#  wnacg-downloader-web —— 飞牛 NAS / Docker 部署配置
#
#  用法：
#    1. cp .env.example .env
#    2. 按需修改下面各项（至少确认端口没被占用）
#    3. docker compose up -d --build
#    4. 浏览器打开 http://<NAS IP>:8082
# ════════════════════════════════════════════════════════════════════

# ── 端口 ────────────────────────────────────────────────────────────
# NAS 上对外暴露的端口。默认 8082，避开 jm 版（8081）和 pica 版（8080）。
WNACG_HOST_PORT=8082

# ── 认证 ────────────────────────────────────────────────────────────
# 默认开启。首次留空会自动生成随机 Token，并在 `docker compose logs`
# 里打印一次；想固定下来就把生成的值填进来。
# 纯局域网自用可设 true 完全关闭认证，打开网页即用、无需登录。
# 代价：/api/config 会明文返回 wnacg Cookie，仅限可信内网。
# 要暴露到公网必须保持 false。
WNACG_AUTH_DISABLED=false
WNACG_AUTH_TOKEN=
WNACG_AUTH_USERNAME=admin

# ── 存储路径 ────────────────────────────────────────────────────────
# 配置 / 日志 / 数据库落在这里。建议绑到 NAS 存储池，方便备份。
WNACG_DATA_PATH=./data

# ── 漫画下载目录 ────────────────────────────────────────────────────
# 下载产物落在这里。首次启动后在网页「配置」里把 downloadDir 改成
# 容器内路径 /comic-download，才能真正写进这个挂载点。
WNACG_COMIC_PATH=./comic-download

# ── 时区 ────────────────────────────────────────────────────────────
TZ=Asia/Shanghai

# ── 构建期代理（可选）──────────────────────────────────────────────
# 国内直连 npm registry / crates.io / github 通常不通，构建会卡在拉依赖。
# 宿主机有代理就填上，注意必须是宿主机的局域网 IP，不能写 127.0.0.1。
#     BUILD_HTTP_PROXY=http://192.168.1.100:7890
#     BUILD_HTTPS_PROXY=http://192.168.1.100:7890
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=

# ── 运行期代理（可选）──────────────────────────────────────────────
# 与构建期是两回事。如果 NAS 直连 wnacg 站点和图片 CDN 不通，
# 必须在这里配代理，否则网页能开、能搜索，但下载会全部超时。
#
# 推荐用 host.docker.internal（compose 里已映射到宿主机），
# 换 NAS 或改 IP 时不用动配置：
#     WNACG_HTTP_PROXY=http://host.docker.internal:7890
#     WNACG_HTTPS_PROXY=http://host.docker.internal:7890
WNACG_HTTP_PROXY=
WNACG_HTTPS_PROXY=